<page-meta root-font-size="{{style.fontsize}}" style="display: flex;">
  <navigation-bar back="{{true}}" title="我的资料"></navigation-bar>
  <view class="contain">
    <scroll-view class="profile-scroll" scroll-y enable-flex show-scrollbar="{{false}}">
      <view class="identity-section">
        <view class="identity-avatar" bind:tap="onUploadPortrait" hover-class="identity-control--pressed"
          aria-role="button" aria-label="更换头像">
          <image wx:if="{{userInfo.avatarUrl}}" src="{{_CDN + userInfo.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="iconfont icon-wode"></text>
        </view>
        <view class="identity-copy">
          <text class="song-title identity-name">{{userInfo.nickName || userInfo.realName || '未设置姓名'}}</text>
          <text>用于邀请函署名</text>
        </view>
        <view class="identity-action" bind:tap="onUploadPortrait" hover-class="identity-control--pressed"
          aria-role="button" aria-label="更换头像">更换</view>
      </view>

      <view class="profile-content">
        <view class="form-section" wx:for="{{forms}}" wx:for-item="section" wx:key="name">
          <view class="section-heading">
            <text class="song-title section-title">{{section.name}}</text>
            <text class="section-hint">{{section.hint}}</text>
          </view>
          <view class="field-list">
            <view class="field-row" wx:for="{{section.list}}" wx:for-item="field" wx:key="key">
              <text class="field-label">{{field.name}}</text>
              <view class="field-control">
                <picker wx:if="{{field.type === 'picker'}}" class="field-picker" mode="{{field.mode}}"
                  value="{{field.value}}" range="{{field.range}}" bindchange="onPickerChange" data-item="{{field}}">
                  <view class="field-value">
                    <text class="_ellipsis {{field.display ? '' : 'placeholder'}}">{{field.display || field.placeholder}}</text>
                    <text class="iconfont icon-a-youjiantou_huaban1 arrow"></text>
                  </view>
                </picker>
                <view wx:else class="field-value" bind:tap="onTapEdit" data-item="{{field}}">
                  <text class="_ellipsis {{field.display ? '' : 'placeholder'}}">{{field.display || field.placeholder}}</text>
                  <text class="iconfont icon-a-youjiantou_huaban1 arrow"></text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="privacy-line">
        <view class="privacy-rule"></view>
        <text>手机号仅用于邀请联系，不会公开显示在邀请函中</text>
      </view>
      <view class="safe-spacer"></view>
    </scroll-view>
  </view>
  <single-edit id="singleEdit" title="{{edit.title}}" placeholder="{{edit.placeholder}}"
    popText="{{edit.popText}}" bind:bindSave="bindSave" />
</page-meta>
