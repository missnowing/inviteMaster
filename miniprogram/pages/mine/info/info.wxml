<page-meta root-font-size="{{style.fontsize}}" style="display: flex;">
    <navigation-bar back="{{true}}" title="编辑我的信息"></navigation-bar>
    <view class="contain">
        <view class="menu">
            <text wx:for="{{forms}}" wx:key="name" data-index="{{index}}"
            class="{{index===selectForm?'active':''}}"
            bind:tap="tapChangeMenu">{{item.name}}</text>
        </view>
        <swiper class="swiper-form" current="{{selectForm}}" bind:change="changeSwiper"
            duration="{{400}}" cache-extent="1"
            scroll-with-animation="true"
        >
            <swiper-item wx:for="{{forms}}" wx:key="name">
                <scroll-view class="formScroll" type="list" scroll-y enable-flex show-scrollbar="{{false}}">
                    <view class="row {{item.sep}}" wx:for="{{forms[index].list}}" wx:key="key">
                        <view>
                            <view>
                                <view class="icon" wx:if="{{item.icon}}">
                                    <text class="{{item.icon}}"/>
                                </view>
                                <text>{{item.name}}</text>
                            </view>
                            <view>
                                <block wx:if="{{item.type === 'image'}}">
                                    <view>
                                        <button bind:tap="onUploadPortrait">
                                            <block wx:if="{{userInfo.avatarUrl}}">
                                                <image src="{{_CDN + userInfo.avatarUrl}}"></image>
                                            </block>
                                            <block wx:else>
                                                <text class="iconfont icon-xiangjixiao" />
                                            </block>
                                        </button>
                                    </view>
                                </block>
                                <block wx:elif="{{item.type === 'picker'}}">
                                    <picker class="picker" mode="{{item.mode}}" value="{{item.value}}"
                                    range="{{item.range}}" bindchange="onPickerChange" data-item="{{item}}">
                                        <view class="pickerAddr _ellipsis">
                                            {{item.display || item.placeholder}}
                                        </view>
                                    </picker>
                                </block>
                                <block wx:else>
                                    <view class="editValue" bind:tap="onTapEdit" data-item="{{item}}">
                                        <text class="_ellipsis {{item.display ? '' : 'placeholder'}}">{{item.display || item.placeholder}}</text>
                                    </view>
                                </block>
                                <text wx:if="{{!item.noArrow}}" class="iconfont icon-a-youjiantou_huaban1 arrow" />
                            </view>
                        </view>
                    </view>
                    <view style="height:env(safe-area-inset-bottom);" />
                </scroll-view>
            </swiper-item>
        </swiper>
    </view>
    <single-edit id="singleEdit" title="{{edit.title}}" placeholder="{{edit.placeholder}}"
        popText="{{edit.popText}}" bind:bindSave="bindSave" />
</page-meta>
