<page-meta root-font-size="{{style.fontsize}}" style="display: flex;">
  <navigation-bar back title="邀请函预览" />
  <view class="contain">
    <view wx:if="{{pageState === 'loading'}}" class="preview-state">
      <view class="state-seal loading"></view>
      <text class="song-title">正在准备预览</text>
      <text>请稍候，正在恢复模板内容…</text>
    </view>

    <view wx:elif="{{pageState === 'error'}}" class="preview-state">
      <text class="state-kicker">PREVIEW</text>
      <view class="state-seal"><text>候</text></view>
      <text class="song-title">暂时无法预览</text>
      <text>{{errorMessage}}</text>
      <button bind:tap="tapRetry">重新加载</button>
    </view>

    <view wx:else class="preview-content">
      <view class="preview-stage">
        <scroll-view scroll-y show-scrollbar="{{false}}" type="list">
          <share-element key="{{se}}" transition-on-gesture transform="true"
            shuttle-on-pop="from" class="shareElement">
            <image src="{{bg}}" mode="widthFix" />
          </share-element>
        </scroll-view>
      </view>

      <view wx:if="{{template}}" class="action-dock">
        <view id="favor" class="action secondary {{favorite ? 'is-favorite' : ''}}"
          bind:tap="tapFavorite" hover-class="action--pressed" aria-role="button"
          aria-label="{{favorite ? '取消收藏' : '收藏'}}">
          <text class="action-icon iconfont {{favorite ? 'icon-xihuan' : 'icon-xihuan1'}}"></text>
          <text>收藏</text>
        </view>
        <view class="action primary" bind:tap="tapCreate"
          hover-class="action--pressed" aria-role="button" aria-label="制作">
          <text>制作</text>
        </view>
      </view>
    </view>
  </view>
</page-meta>
